datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  passwordHash   String
  role           String         @default("CITIZEN") // CITIZEN, OFFICER, ADMIN
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  phone          String?
  area           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  complaints         Complaint[]
  updates            ComplaintUpdate[]
  assignedToMe       ComplaintAssignment[]     @relation("OfficerAssignments")
  createdAssignments ComplaintAssignment[]     @relation("CreatedAssignments")
  affectedOutages    OutageAffectedUser[]
  auditLogs          AuditLog[]
  feedbacks          ResolutionFeedback[]
  notifications      Notification[]
}

model Department {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique // e.g. ELEC, ROAD, SANI, WATR, LGT
  description  String?
  contactEmail String?
  createdAt    DateTime    @default(now())

  users        User[]
  assignments  ComplaintAssignment[]
  outages      ElectricityOutageIncident[]
}

model ComplaintCategory {
  id          String      @id @default(uuid())
  name        String
  code        String      @unique
  description String?
  SLAHours    Int         @default(24)
  icon        String      @default("AlertTriangle")

  complaints  Complaint[]
}

model Complaint {
  id               String            @id @default(uuid())
  refNumber        String            @unique
  title            String
  description      String
  categoryId       String
  category         ComplaintCategory @relation(fields: [categoryId], references: [id])
  userId           String
  user             User              @relation(fields: [userId], references: [id])

  locationName     String
  address          String?
  latitude         Float?
  longitude        Float?

  priority         String            @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status           String            @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, ASSIGNED, IN_PROGRESS, AWAITING_INFO, RESOLVED, REOPENED, CLOSED

  photoUrl         String?
  isEmergency      Boolean           @default(false)
  affectedCount    Int               @default(1)
  isOutage         Boolean           @default(false)

  outageIncidentId String?
  outageIncident   ElectricityOutageIncident? @relation(fields: [outageIncidentId], references: [id])

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  resolvedAt       DateTime?

  assignments      ComplaintAssignment[]
  updates          ComplaintUpdate[]
  evidence         ComplaintEvidence[]
  affectedRecords  OutageAffectedUser[]
  feedback         ResolutionFeedback?
}

model ComplaintAssignment {
  id               String      @id @default(uuid())
  complaintId      String
  complaint        Complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  departmentId     String
  department       Department  @relation(fields: [departmentId], references: [id])
  officerId        String?
  officer          User?       @relation("OfficerAssignments", fields: [officerId], references: [id])
  assignedByUserId String
  assignedByUser   User        @relation("CreatedAssignments", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime    @default(now())
  notes            String?
}

model ComplaintUpdate {
  id                   String      @id @default(uuid())
  complaintId          String
  complaint            Complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId             String
  author               User        @relation(fields: [authorId], references: [id])
  authorRole           String      // CITIZEN, OFFICER, ADMIN
  statusChange         String?
  officialRemark       String?
  estimatedRestoration DateTime?
  isOfficial           Boolean     @default(false)
  evidenceUrl          String?
  createdAt            DateTime    @default(now())

  evidence             ComplaintEvidence[]
}

model ComplaintEvidence {
  id           String           @id @default(uuid())
  complaintId  String
  complaint    Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  updateId     String?
  update       ComplaintUpdate? @relation(fields: [updateId], references: [id])
  fileUrl      String
  fileType     String           @default("image/jpeg")
  uploadedAt   DateTime         @default(now())
}

model ElectricityOutageIncident {
  id                 String      @id @default(uuid())
  title              String
  locality           String
  startTime          DateTime
  isCurrentlyOff     Boolean     @default(true)
  weatherCondition   String?     // Rain, Storm, Winds, Clear, etc.
  outageCategory     String      @default("UNEXPECTED") // UNEXPECTED, PLANNED, RAIN_STORM, TRANSFORMER, MAINTENANCE, DISTRIBUTION_FAULT, UNKNOWN
  affectedHouseholds Int         @default(1)
  status             String      @default("INVESTIGATING") // REPORTED, INVESTIGATING, CONFIRMED, REPAIRING, RESTORED
  confirmedReason    String?
  expectedRestoration DateTime?
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  complaints         Complaint[]
  affectedUsers      OutageAffectedUser[]
}

model OutageAffectedUser {
  id          String                    @id @default(uuid())
  incidentId  String
  incident    ElectricityOutageIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId      String
  user        User                      @relation(fields: [userId], references: [id])
  complaintId String?
  complaint   Complaint?                @relation(fields: [complaintId], references: [id])
  reportedAt  DateTime                  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ResolutionFeedback {
  id          String    @id @default(uuid())
  complaintId String    @unique
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  rating      Int       @default(5)
  comment     String?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  userRole   String   @default("SYSTEM")
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}
